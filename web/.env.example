NODE_ENV=development
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
ODOO_BASE_URL=http://localhost:8069
ODOO_ACCOUNTS_API_KEY=replace-with-a-long-random-secret
REDIS_URL=redis://localhost:6379/0
COOKIE_KEYS=replace-key-one,replace-key-two
# Production: JSON Web Key Set containing private signing keys.
# OIDC_JWKS={"keys":[...]}
# Development fallback when Odoo has no registered clients yet.
OIDC_CLIENTS_JSON=[{"client_id":"local-demo","client_name":"Local Demo","redirect_uris":["http://localhost:4000/callback"],"post_logout_redirect_uris":["http://localhost:4000"],"response_types":["code"],"grant_types":["authorization_code","refresh_token"],"token_endpoint_auth_method":"none"}]
POLICY_VERSION=2026-07-13
TERMS_URL=https://kodingyuk.id/terms
PRIVACY_URL=https://kodingyuk.id/privacy
TRUST_PROXY=1
