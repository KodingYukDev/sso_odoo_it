<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_accounts" model="ir.module.category">
        <field name="name">KodingYuk Accounts</field>
        <field name="description">Manage external public and student accounts.</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_accounts_user" model="res.groups">
        <field name="name">Accounts Viewer</field>
        <field name="category_id" ref="module_category_accounts"/>
    </record>

    <record id="group_accounts_manager" model="res.groups">
        <field name="name">Accounts Manager</field>
        <field name="category_id" ref="module_category_accounts"/>
        <field name="implied_ids" eval="[(4, ref('group_accounts_user'))]"/>
    </record>
</odoo>
